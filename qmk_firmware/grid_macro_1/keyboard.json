{
    "keyboard_name": "Grid Macro 1",
    "manufacturer": "NØDE",
    "url": "https://node-studio.local",
    "maintainer": "NØDE",
    "usb": {
        "vid": "0xFEED",
        "pid": "0x6001",
        "device_version": "1.0.0"
    },
    "features": {
        "bootmagic": true,
        "command": false,
        "console": false,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "rgblight": true,
        "encoder": true,
        "raw": true,
        "via": true
    },
    "matrix_pins": {
        "direct": [
            ["GP0", "GP1", "GP2"],
            ["GP3", "GP4", "GP5"],
            ["GP6", "GP7", "GP8"],
            ["GP11", null, null]
        ]
    },
    "encoder": {
        "rotary": [
            {"pin_a": "GP9", "pin_b": "GP10", "resolution": 4}
        ]
    },
    "rgblight": {
        "pin": "GP16",
        "led_count": 1,
        "driver": "ws2812",
        "animations": {
            "all": true
        }
    },
    "processor": "RP2040",
    "bootloader": "rp2040",
    "layouts": {
